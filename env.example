# Gmail SMTP Configuration (via nodemailer)
# The Gmail address used to authenticate and send the contact form emails.
# Requires a 2-step-verification App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# The email address that will receive the contact form submissions.
# Defaults to GMAIL_USER if not set.
CONTACT_TO=your-address@gmail.com
